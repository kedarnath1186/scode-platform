# =============================================================================
# SCode Platform — Environment Configuration Example (.env)
# =============================================================================

# Server Port (default: 3000)
PORT=3000

# Environment Mode (development | production)
NODE_ENV=development

# JWT Secret for Signing Admin Authentication Tokens (Required in Production)
JWT_SECRET=your_production_jwt_secret_key_random_64_chars

# Allowed CORS Origin for Production (comma-separated if multiple, e.g. https://scode.in,https://admin.scode.in)
ALLOWED_ORIGIN=https://scode.in

# =============================================================================
# Razorpay Payment Gateway Configuration (India: UPI / Cards / Netbanking)
# =============================================================================
# Get your API keys from: https://dashboard.razorpay.com/#/app/keys
# In local development without live keys, a simulated sandbox payment flow operates automatically.

# Razorpay Key ID (e.g. rzp_test_... or rzp_live_...)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id

# Razorpay Key Secret (Server-side ONLY, never exposed to client)
RAZORPAY_KEY_SECRET=placeholder_secret_never_share

# Razorpay Webhook Secret for HMAC SHA256 Verification on /api/billing/webhook
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret
